{
  "name": "running-light",
  "version": "1.0.0",
  "private": true,
  "description": "Running Light - perya bulb-track game (play credits only, no real money).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "node --test --test-reporter=spec \"test/unit/**/*.test.js\"",
    "test:unit": "node --test --test-reporter=spec \"test/unit/**/*.test.js\"",
    "sim": "node scripts/simulate.js",
    "sim:quick": "node scripts/simulate.js --rounds 1000000 --out test-results/sim",
    "pretest:ui": "npm run build",
    "test:ui":"node --test --test-concurrency=1 --test-reporter=spec test/ui/ui.test.js",
    "screenshots:v3": "node test/ui/screenshots-v3.js",
    "perf:trace": "node test/ui/perf-trace.js",
    "tokens": "node scripts/gen-tokens.js",
    "predev": "node scripts/gen-tokens.js",
    "prebuild": "node scripts/gen-tokens.js"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "puppeteer-core": "^23.0.0",
    "vite": "^5.4.0"
  }
}
