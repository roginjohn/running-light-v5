  "layout": {
    "frame-max-width": 1600,
    "frame-max-height": 980,
    "frame-margin-min": 16,
    "track": {
      "cols": 16,
      "rows": 11,
      "squares": 50,
      "order": "#1 top-left, clockwise",
      "gap": 6,
      "pitch-max": 70,
      "pitch-min": 40
    },
    "track-pitch-formula": "pitch = clamp(40, floor(min(trackBoxW / 16, trackBoxH / 11)), 70); tile = pitch - 6",
    "breakpoints": {
      "desktop": {
        "match": "width >= 1200",
        "structure": "frame [rail 230 | divider 1 | game] + bottombar 40",
        "pitch": "70 at 1920x1080, 50 at 1280x720"
      },
      "tablet-portrait": {
        "match": "600-1199 and portrait",
        "structure": "frame [game] / [rail as 2-column control block] / bottombar 40",
        "pitch": "45 at 768x1024"
      }
    }
  },
  "motion": {
    "rule": "animate transform and opacity only",
    "light-step": {
      "property": "opacity",
      "duration-ms": 0,
      "note": "lit tile swaps instantly; trail fades via opacity 120 ms"
    },
    "trail-fade-ms": 120,
    "press-ms": 80,
    "panel-in-ms": 160,
    "gamble-flip-ms": 700,
    "gamble-flip": "transform: rotateY on a single disc element (2 faces, backface-visibility hidden)",
    "payout-count-ms": 600,
    "easing": "cubic-bezier(.2,.8,.2,1)",
    "reduced-motion": "no flip rotation (crossfade 120 ms), light jumps in 3 steps then stops, no count-up"
  },
